{
  "name": "gxper-motion",
  "version": "1.0.0",
  "description": "GXPER website motion system — tokens, CSS animations and JS controllers",
  "type": "module",
  "main": "src/js/index.js",
  "style": "src/styles/gxper-motion.css",
  "files": ["src", "dist", "docs"],
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:min",
    "build:js": "esbuild src/js/index.js --bundle --format=iife --global-name=GXMotion --target=es2019 --outfile=dist/gxper-motion.js",
    "build:css": "esbuild src/styles/gxper-motion.css --bundle --outfile=dist/gxper-motion.css",
    "build:min": "esbuild src/js/index.js --bundle --minify --format=iife --global-name=GXMotion --target=es2019 --outfile=dist/gxper-motion.min.js && esbuild src/styles/gxper-motion.css --bundle --minify --outfile=dist/gxper-motion.min.css",
    "demo": "npx --yes serve . -l 5173"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "license": "UNLICENSED",
  "private": true
}
